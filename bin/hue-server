#!/usr/bin/env php
<?php

$autoloadFiles = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../../../../autoload.php',
];

$autoloadFile = null;
foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        $autoloadFile = $file;
        break;
    }
}

if (!$autoloadFile) {
    fwrite(STDERR, "Autoload file not found.\n");
    exit(1);
}

require_once $autoloadFile;

use OguzhanTogay\HueClient\HueClient;
use OguzhanTogay\HueClient\Discovery\BridgeDiscovery;

$options = getopt('h:u:p:b:dk:', [
    'help', 'host:', 'username:', 'port:', 'bind:', 'discover', 'api-key:', 'insecure', 'cors:',
]);

if (isset($options['help'])) {
    echo <<<HELP
    Philips Hue REST API Server

    Usage: hue-server [OPTIONS]

    Options:
      -h, --host       Bridge IP address              (HUE_BRIDGE_IP)
      -u, --username   Bridge username / app key      (HUE_USERNAME)
      -p, --port       Port to listen on, default 8080 (HUE_PORT)
      -b, --bind       Address to listen on, default 127.0.0.1 (HUE_BIND)
      -k, --api-key    Key clients must send          (HUE_API_KEY)
          --insecure   Run without an API key — trusted networks only (HUE_API_INSECURE=1)
          --cors       Comma-separated browser origins allowed to call the API (HUE_CORS_ORIGINS)
      -d, --discover   Find the bridge through Philips' discovery service
          --help       Show this help

    Clients send the key as "Authorization: Bearer <key>" or "X-API-Key: <key>".
    /api/health and /docs need no key.

    Examples:
      hue-server -h 192.168.1.100 -u <username> -k "\$(openssl rand -hex 24)"
      HUE_BRIDGE_IP=192.168.1.100 HUE_USERNAME=<username> HUE_API_KEY=<key> hue-server --bind 0.0.0.0

    HELP;
    exit(0);
}

$env = static fn (string $name): ?string => (getenv($name) !== false && getenv($name) !== '') ? getenv($name) : null;

$bridgeIp = $options['h'] ?? $options['host'] ?? $env('HUE_BRIDGE_IP');
$username = $options['u'] ?? $options['username'] ?? $env('HUE_USERNAME');
$port = (int) ($options['p'] ?? $options['port'] ?? $env('HUE_PORT') ?? 8080);
$bind = $options['b'] ?? $options['bind'] ?? $env('HUE_BIND') ?? '127.0.0.1';
$apiKey = $options['k'] ?? $options['api-key'] ?? $env('HUE_API_KEY');
$insecure = isset($options['insecure']) || filter_var($env('HUE_API_INSECURE') ?? 'false', FILTER_VALIDATE_BOOLEAN);
$cors = $options['cors'] ?? $env('HUE_CORS_ORIGINS') ?? '';

if (isset($options['d']) || isset($options['discover']) || !$bridgeIp) {
    echo "🔍 Discovering Hue Bridge...\n";
    $bridges = (new BridgeDiscovery())->discover();
    if ($bridges === []) {
        fwrite(STDERR, "❌ No Hue bridge found. Pass -h <ip> or set HUE_BRIDGE_IP.\n");
        exit(1);
    }
    $bridgeIp = $bridges[0]->getIp();
    echo "✅ Found bridge at {$bridgeIp}\n";
}

if (!$username) {
    fwrite(STDERR, "❌ Username not provided. Use -u <username> or set HUE_USERNAME.\n");
    fwrite(STDERR, "💡 To get one, press the bridge's link button and run: hue setup\n");
    exit(1);
}

if (!$apiKey && !$insecure) {
    fwrite(STDERR, "❌ No API key. Pass -k <key> (or set HUE_API_KEY), or --insecure on a trusted network.\n");
    exit(1);
}

if (!(new HueClient($bridgeIp, $username, ['retry_attempts' => 0]))->isConnected()) {
    fwrite(STDERR, "❌ Cannot reach the bridge at {$bridgeIp} with that username.\n");
    exit(1);
}

$router = realpath(__DIR__ . '/../public/api.php');
$environment = getenv() + [
    'HUE_BRIDGE_IP' => $bridgeIp,
    'HUE_USERNAME' => $username,
    'HUE_AUTO_DISCOVER' => 'false',
    'HUE_API_KEY' => (string) $apiKey,
    'HUE_API_INSECURE' => $insecure ? '1' : '0',
    'HUE_CORS_ORIGINS' => $cors,
];
// Values given on the command line win over inherited ones.
$environment = array_merge($environment, array_filter([
    'HUE_BRIDGE_IP' => $bridgeIp,
    'HUE_USERNAME' => $username,
    'HUE_API_KEY' => $apiKey,
    'HUE_API_INSECURE' => $insecure ? '1' : null,
    'HUE_CORS_ORIGINS' => $cors !== '' ? $cors : null,
]));

echo "🚀 Hue REST API on http://{$bind}:{$port}/api (bridge {$bridgeIp})\n";
echo $insecure && !$apiKey
    ? "⚠️  No API key: anyone who can reach this port controls your lights.\n"
    : "🔑 Clients must send the API key.\n";
echo "📚 Docs: http://{$bind}:{$port}/docs — Ctrl+C to stop\n\n";

$process = proc_open(
    [PHP_BINARY, '-S', "{$bind}:{$port}", $router],
    [STDIN, STDOUT, STDERR],
    $pipes,
    dirname($router),
    $environment
);

exit($process === false ? 1 : proc_close($process));
