# Philips Hue Bridge Configuration
HUE_BRIDGE_IP=192.168.1.100
HUE_USERNAME=your-hue-username-here

# Auto-discovery on every request when HUE_BRIDGE_IP is empty. Off by default:
# Philips rate limits its discovery service. Prefer setting HUE_BRIDGE_IP.
HUE_AUTO_DISCOVER=false

# Server Configuration
HUE_PORT=8080

# REST API access. Clients send the key as "Authorization: Bearer <key>".
# Generate one with: openssl rand -hex 24
HUE_API_KEY=
# Set to 1 to run without a key, on a trusted network only.
HUE_API_INSECURE=0
# Comma-separated browser origins allowed to call the API (empty = none).
HUE_CORS_ORIGINS=
# Show error details in responses (development only).
HUE_DEBUG=0

# Webhooks (POST /hooks/github, /hooks/sentry). Empty secret = endpoint off.
HUE_GITHUB_WEBHOOK_SECRET=
HUE_SENTRY_WEBHOOK_SECRET=
# Lamps to light (names or ids, comma separated); default: the notifier's lamps.
HUE_WEBHOOK_LIGHTS=
# Only these GitHub branches (comma separated); default: all.
HUE_GITHUB_BRANCHES=
# Where seen delivery ids are kept to refuse replays; default: the system temp dir.
HUE_WEBHOOK_STATE_DIR=

# Cache Configuration
CACHE_TTL=300

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Development
APP_ENV=production
LOG_LEVEL=info